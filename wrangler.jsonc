{
  "name": "piscine-max",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "peaceinblue-platform",
      "database_id": "local-peaceinblue",
      "migrations_dir": "schema"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "peaceinblue-local-photos"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "peaceinblue-platform-preview",
          "database_id": "local-peaceinblue-preview",
          "migrations_dir": "schema"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "peaceinblue-preview-photos"
        }
      ]
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "piscine-max",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piscine-max-production",
      "database_id": "d5b477c2-1899-481d-ab38-21b95ded5e10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "piscine-max-photos"
    }
  ]
}
